# Google OAuth web-client ID for the Google Sign-In stub (expo-auth-session).
# Create one in Google Cloud Console (OAuth client ID → Web application).
# Leave empty: the app then reports "not configured" instead of faking a session.
# Never commit a filled-in .env — only this .env.example (AGENTS.md §6).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Quiz-chain node base URL for the Mining tab, e.g. http://192.168.1.10:4100
# (the machine running `node packages/backend/dist/chain/node.js`).
# Leave empty: the Mining tab shows honest offline states instead of faking data.
EXPO_PUBLIC_QUIZ_CHAIN_URL=

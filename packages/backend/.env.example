# ===================================================================
# @nexus/backend — copy to .env and fill in (NEVER commit .env)
# ===================================================================

# --- HTTP node -----------------------------------------------------
PORT=4100
ADMIN_PASSWORD=change-me-now
# POW_BITS=12
# BLOCK_INTERVAL_MS=60000
# BLOCK_JITTER_MS=10000
# CHAIN_DATA_DIR=./.chain-data

# --- Polygon Amoy testnet milestone anchor (TESTNET ONLY) ----------
# Deploy MilestoneAnchor first (see packages/contracts/README.md), then paste
# the deployed address here. The key funds the recordMilestone txs.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=

# --- P2P peer sync (optional) ---------------------------------------
# Comma-separated URLs of other quiz-chain nodes to sync from. Fork choice:
# a peer chain is adopted ONLY when it passes the full verifyChain rule set
# AND carries more cumulative PoW work than our own chain.
PEER_URLS=
# PEER_SYNC_INTERVAL_MS=30000

# --- world-v1 AI evaluation (world:ai-eval) -------------------------
# The eval harness calls a real model over HTTPS; without a key the CLI
# refuses to run (no mock results are ever produced).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NEXUS_AI_PROVIDER=gemini
# NEXUS_AI_MODEL=gemini-2.5-flash
# NEXUS_AI_ENDPOINT=

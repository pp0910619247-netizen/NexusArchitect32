# Nexus Architect contracts — environment template.
#
# Copy this file to `.env` (gitignored) and put real values THERE, never here:
# this file is tracked by Git, so anything written into it is published.
# Project rule: never commit a private key, mnemonic or API key (§6 security).

# --- Deploy targets (Polygon Amoy testnet only, chainId 80002) ---
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Amoy deployment key (script/Deploy.s.sol, script/DeployMilestoneAnchor.s.sol,
# script/DeployQuizQuestionSet.s.sol). Leave empty in this template and set it
# in `.env` with a throwaway testnet key — never a key that holds real funds.
PRIVATE_KEY=

# Recipients used by script/Deploy.s.sol
IMPACT_TREASURY_ADDRESS=
TEAM_ADDRESS=

# --- QuizQuestionSet: publish ONE quiz set on chain ---
# script/DeployQuizQuestionSet.s.sol reads the public text from
# `data/quiz-set-1.json` and these two secrets from the environment only.
# Without an unguessable 32-byte salt, a 4-option answer is brute-forceable.
# QUIZ_ANSWER_INDEX=
# QUIZ_ANSWER_SALT=
# QUIZ_OWNER=
# QUIZ_SET_FILE=

# --- Reveal the committed answer ---
# script/RevealQuizAnswer.s.sol (reuses QUIZ_ANSWER_INDEX + QUIZ_ANSWER_SALT)
# QUIZ_REGISTRY=
# QUIZ_SET_ID=
